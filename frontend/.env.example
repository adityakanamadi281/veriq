# Frontend environment (browser-safe only).
# Never put GEMINI_API_KEY, SUPABASE_SERVICE_ROLE_KEY, or DATABASE_URL here.

# FastAPI base URL. Leave empty in dev to use the Vite dev proxy at /api/v1.
# In production (Vercel) set this to the Render backend, e.g.:
#   VITE_API_URL=https://veriq-backend.onrender.com/api/v1
VITE_API_URL=http://localhost:8000

# Supabase anon/publishable key — browser-safe. Required for auth.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
