{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "apiKeyHelper": "python -c \"import os; print(os.environ['FIREWORKS_API_KEY'])\"",
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.fireworks.ai/inference",
    "ANTHROPIC_MODEL": "accounts/fireworks/models/glm-5p2",
    "ANTHROPIC_SMALL_FAST_MODEL": "accounts/fireworks/models/kimi-k3", 
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "accounts/fireworks/models/kimi-k2p7-code", 
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "accounts/fireworks/models/kimi-k2p6", 
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "accounts/fireworks/routers/kimi-k2p6-turbo"
  },
  "model": "accounts/fireworks/models/kimi-k3" 
}

